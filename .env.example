DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true&connection_limit=10"
# In production (Prisma Postgres) and for the Neon dev database (see CLAUDE.md's "Local dev
# database" section), DATABASE_URL is the pooled connection string and DIRECT_URL is the direct
# (non-pooled) one used for migrations/CLI. connection_limit must be >1 on the pooled URL --
# several code paths issue many queries concurrently, and a limit of 1 causes pool-timeout errors.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"
ADMIN_PASSWORD="changeme"
